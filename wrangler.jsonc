{
  "name": "flightboard1",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/.netlify/functions/*"]
  },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "flightboard-data",
    "database_id": "def7150a-3ec0-4d89-a918-fab037cb6f5b"
  }]
}
